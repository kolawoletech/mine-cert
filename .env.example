# Copy this file to .env for local development. These credentials are for the
# local Docker database only; never use them outside a development environment.

POSTGRES_USER=minecert
POSTGRES_PASSWORD=minecert_local_only
POSTGRES_DB=minecert
POSTGRES_PORT=5435

DATABASE_URL=postgresql://minecert:minecert_local_only@127.0.0.1:5435/minecert?schema=public
PORT=3001

# Configure all OIDC values to enable sign-in. Set the callback URL in the
# identity provider to http://localhost:3000/api/auth/callback/minecert-oidc.
AUTH_SECRET=
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_PROVIDER_NAME=Organisation sign-in
AUTH_TRUST_HOST=true
