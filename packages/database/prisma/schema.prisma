generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum EquipmentStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  DECOMMISSIONED
}

enum CertificateStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  SUPERSEDED
  WITHDRAWN
  REVOKED
}

enum DocumentCategory {
  TECHNICAL
  CERTIFICATE
  INSPECTION
  MAINTENANCE
  OTHER
}

model Organization {
  id                   String                  @id @default(cuid())
  name                 String
  slug                 String                  @unique
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  memberships          OrganizationMembership[]
  equipment            Equipment[]
  issuedCertificates   Certificate[]           @relation("CertificateIssuer")
  documents            Document[]

  @@index([name])
}

model User {
  id                   String                  @id @default(cuid())
  email                String                  @unique
  name                 String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  memberships          OrganizationMembership[]
  uploadedVersions     DocumentVersion[]       @relation("DocumentVersionUploader")
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  status         MembershipStatus @default(INVITED)
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleAssignments MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model Role {
  id             String           @id @default(cuid())
  name           String
  code           String           @unique
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  permissions    RolePermission[]
  assignments    MembershipRole[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model MembershipRole {
  membershipId String
  roleId       String
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
}

model EquipmentType {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  equipment   Equipment[]
}

model Manufacturer {
  id          String      @id @default(cuid())
  name        String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  equipment   Equipment[]
}

model Equipment {
  id               String                 @id @default(cuid())
  organizationId   String
  equipmentTypeId  String
  manufacturerId   String?
  equipmentIdentifier String
  slotNumber       String?
  serialNumber     String?
  model            String?
  status           EquipmentStatus        @default(ACTIVE)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipmentType    EquipmentType          @relation(fields: [equipmentTypeId], references: [id], onDelete: Restrict)
  manufacturer     Manufacturer?          @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  certificates     EquipmentCertificate[]
  documents        EquipmentDocument[]

  @@unique([organizationId, equipmentIdentifier])
  @@unique([organizationId, slotNumber])
  @@index([organizationId, status])
  @@index([serialNumber])
}

model Certificate {
  id                   String                 @id @default(cuid())
  issuerOrganizationId String
  certificateNumber    String
  status               CertificateStatus      @default(DRAFT)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  issuer               Organization           @relation("CertificateIssuer", fields: [issuerOrganizationId], references: [id], onDelete: Restrict)
  revisions            CertificateRevision[]
  equipment            EquipmentCertificate[]
  documents            CertificateDocument[]

  @@unique([issuerOrganizationId, certificateNumber])
  @@index([issuerOrganizationId, status])
}

model CertificateRevision {
  id             String            @id @default(cuid())
  certificateId  String
  revisionNumber Int
  status         CertificateStatus
  publishedAt    DateTime?
  validFrom      DateTime?
  validUntil     DateTime?
  createdAt      DateTime          @default(now())
  certificate    Certificate       @relation(fields: [certificateId], references: [id], onDelete: Restrict)

  @@unique([certificateId, revisionNumber])
  @@index([certificateId, status])
}

model EquipmentCertificate {
  equipmentId   String
  certificateId String
  linkedAt      DateTime    @default(now())
  equipment     Equipment   @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Restrict)

  @@id([equipmentId, certificateId])
  @@index([certificateId])
}

model Document {
  id                    String               @id @default(cuid())
  organizationId        String
  title                 String
  category              DocumentCategory     @default(OTHER)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions              DocumentVersion[]
  equipment             EquipmentDocument[]
  certificates          CertificateDocument[]

  @@index([organizationId, category])
}

model DocumentVersion {
  id                 String   @id @default(cuid())
  documentId         String
  versionNumber      Int
  storageKey         String   @unique
  originalFilename   String
  mimeType           String
  sizeBytes          BigInt
  checksumSha256     String
  uploadedById       String
  createdAt          DateTime @default(now())
  document           Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  uploadedBy         User     @relation("DocumentVersionUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNumber])
  @@index([uploadedById, createdAt])
}

model EquipmentDocument {
  equipmentId String
  documentId  String
  linkedAt    DateTime  @default(now())
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([equipmentId, documentId])
  @@index([documentId])
}

model CertificateDocument {
  certificateId String
  documentId    String
  linkedAt      DateTime    @default(now())
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  document      Document    @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([certificateId, documentId])
  @@index([documentId])
}
