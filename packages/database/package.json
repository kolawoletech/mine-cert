{
  "name": "@minecert/database",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    }
  },
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:status": "dotenv -e ../../.env -- prisma migrate status",
    "db:validate": "dotenv -e ../../.env -- prisma validate"
  },
  "dependencies": {
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "dotenv-cli": "10.0.0",
    "prisma": "6.19.0"
  }
}
